<!DOCTYPE module SYSTEM "module.dtd">

<module name="depth_estimation">
  <doc>
    <description>
    Module using monocular vision for depth estimation
    </description>
  </doc>
  <header>
    <file name="depth_estimation.h"/>
    <file name="depth_model.h"/>
  </header>
  <init fun="depth_estimation_init()"/>
  <periodic fun="depth_estimation_periodic()" freq="10"/>
  <makefile target="ap|nps">
    <file name="depth_model.c"/>
    <file name="depth_estimation.c"/>
  </makefile>
</module>
